{
   "manifest_version": 3,
   "name": "Auto Login",
   "author": "Muthukumaran Navaneethakrishnan(https://github.com/muthuishere)",
   "version": "5.0.0",
   "description": "Automatically login to your favourite websites without entering credentials",
   "key": "",
   
   "background": {
     "service_worker": "background-bundle.js"
   },
 
   "action": {},
 
   "content_scripts": [{
     "js": ["js/vapi-client.js", "js/utils.js"],
     "matches": ["http://*/*", "https://*/*"],
     "run_at": "document_start"
   }],
 
   "web_accessible_resources": [{
     "resources": [
       "js/*.js",       
       "images/*.png", 
       "images/*.jpg",
       "css/*.css"
     ],
     "matches": ["<all_urls>"]
   }],
 
   "options_ui": {
     "page": "options.html",
     "open_in_tab": true
   },
 
   "permissions": [
     "tabs",
     "storage",  
     "scripting"
   ],
 
   "host_permissions": [
     "http://*/*",
     "https://*/*"
   ],
 
   "icons": {
     "128": "images/autologin-128.png",
     "48": "images/autologin-48.png",
     "64": "images/autologin-64.png"
   },
 
   "default_locale": "en",
   "homepage_url": "https://www.facebook.com/Auto-Login-433751853437039/"
 }